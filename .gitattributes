# ── 行尾统一：仓库内一律 LF，检出时不转换（避免 Windows 上 CRLF 污染 diff）──
* text=auto eol=lf

# ── Windows 脚本必须 CRLF，否则 PowerShell 可能解析异常 ──
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# ── 二进制 ──
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.cbz  binary
*.zip  binary
*.xml  text eol=lf
